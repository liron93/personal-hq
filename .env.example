NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# server-only — לא NEXT_PUBLIC. נקרא רק ב-app/api/quote (Route Handler), אף פעם לא בדפדפן.
FINNHUB_API_KEY=

# server-only — לא NEXT_PUBLIC. נקרא רק ב-app/api/jarvis (Route Handler). אופציונלי — בלי זה, JARVIS מציג טקסט קבוע.
GEMINI_API_KEY=

# Server-only. Never prefix these with NEXT_PUBLIC. Redeploy after configuring.
# 32 random bytes encoded as 64 hex characters. Encrypts per-browser API-key cookies.
# Never expose this value to the client. Rotation invalidates saved connections.
EODHD_COOKIE_SECRET=
# Comma-separated verified Supabase user UUIDs allowed to use this personal feed.
EODHD_ALLOWED_USER_IDS=

# Server-only. Required allowlist for JARVIS/quote routes: comma-separated Supabase user UUIDs.
# Deny-by-default: unset/empty/invalid = no real user is allowed (403), not "anyone signed in".
# Does not apply to /api/market/eodhd, which has its own EODHD_ALLOWED_USER_IDS. See docs/api-auth.md.
API_ALLOWED_USER_IDS=

# Server-only — never NEXT_PUBLIC. Read only by lib/supabase-admin.mjs, for the Hevy health
# integration (app/api/health/hevy/*). Bypasses RLS — never import lib/supabase-admin.mjs
# from a "use client" file. Find it in Supabase project settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — never NEXT_PUBLIC. 32 random bytes encoded as 64 hex characters (same format
# as EODHD_COOKIE_SECRET, generated separately — rotating one must not affect the other).
# Encrypts each user's saved Hevy API key before it is written to Supabase (lib/hevy-key.mjs).
# Unset/invalid format = Hevy connect/test/import routes respond 503 "not configured" — never
# an insecure fallback. Rotating this value invalidates every saved Hevy connection.
HEVY_KEY_ENCRYPTION_SECRET=

# LOCAL DEVELOPMENT ONLY. Set to 1 to let unauthenticated local requests use the API when
# NODE_ENV is not production. Ignored in production builds. Never set on Vercel.
ALLOW_DEMO_API=

# Server-only — never NEXT_PUBLIC_. Read only in app/api/riseup/budget (Route Handler), never
# in the browser. A single shared RiseUp Personal Access Token (format: riseup_pat_<token>)
# with budget:read scope — not a per-user key like EODHD's. Unset = "not configured", a normal
# handled state (503), not an error. See lib/riseup-key.mjs.
RISEUP_PAT=
